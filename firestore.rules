rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "shimopus@gmail.com" && request.auth.token.email_verified == true;
    }

    match /polls/{pollId} {
      allow read, write: if isAdmin();
    }

    match /deletedPolls/{pollId} {
      allow read, write: if isAdmin();
    }

    match /botMessages/{messageId} {
      allow read, write: if isAdmin();
    }

    match /rawUpdates/{updateId} {
      allow read, write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
